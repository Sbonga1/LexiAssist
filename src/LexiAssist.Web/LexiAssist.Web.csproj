<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);**/bin/**;**/obj/**</DefaultItemExcludesInProjectFolder>
    <UserSecretsId>aspnet-LexiAssist.Web-2dbe3c62-5517-47a9-bde5-8c94be60ca27</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/Migrations/AzureSql/AzureSqlInitial.Up.sql" LogicalName="LexiAssist.Web.Data.Migrations.AzureSql.AzureSqlInitial.Up.sql" />
    <EmbeddedResource Include="Data/Migrations/AzureSql/AzureSqlInitial.Down.sql" LogicalName="LexiAssist.Web.Data.Migrations.AzureSql.AzureSqlInitial.Down.sql" />
  </ItemGroup>

</Project>
