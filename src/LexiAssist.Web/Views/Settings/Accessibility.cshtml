@model LexiAssist.Web.ViewModels.AccessibilityPreferencesViewModel
@{
    ViewData["Title"] = "Reading and accessibility settings";
}

<section class="preferences-page" aria-labelledby="settings-heading">
    <header class="preferences-heading">
        <p class="auth-eyebrow">Your preferences</p>
        <h1 id="settings-heading">Reading and accessibility</h1>
        <p class="preferences-intro">Choose the reading options that feel comfortable. Your choices are saved to your account.</p>
    </header>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="alert alert-success preferences-status" role="status">@statusMessage</div>
    }

    <form asp-action="Accessibility" method="post" class="preferences-panel">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="preference-row preference-row-background">
            <div class="preference-info">
                <span class="preference-icon preference-icon-background" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M12 3.5c-4.8 0-8.5 3.1-8.5 7.3 0 3.6 2.7 6.2 6.2 6.2h1.1c.7 0 1.2-.5 1.2-1.2 0-.9-.5-1.2-.5-2s.6-1.4 1.4-1.4h2.3c3.2 0 5.3-2 5.3-4.9 0-2.3-1.9-4-4.4-4H12Z" />
                        <circle cx="7.2" cy="10" r=".8" />
                        <circle cx="10.5" cy="7.5" r=".8" />
                        <circle cx="14.2" cy="7.4" r=".8" />
                    </svg>
                </span>
                <div>
                    <h2>Reading background</h2>
                    <p>Choose a reading background that's comfortable for you.</p>
                </div>
            </div>
            <div class="preference-controls">
                <label asp-for="BackgroundTheme" class="visually-hidden"></label>
                <select asp-for="BackgroundTheme" class="form-select">
                    <option value="standard-light">Standard Light</option>
                    <option value="warm-cream">Warm Cream</option>
                    <option value="soft-blue">Soft Blue</option>
                    <option value="muted-gray">Muted Gray</option>
                </select>
                <span asp-validation-for="BackgroundTheme" aria-live="polite" class="text-danger"></span>
            </div>
        </div>

        <div class="preference-row preference-row-font">
            <div class="preference-info">
                <span class="preference-icon preference-icon-font" aria-hidden="true">Aa</span>
                <div>
                    <h2>Font size</h2>
                    <p>Adjust from 90% to 130% of the standard text size.</p>
                </div>
            </div>
            <div class="preference-controls">
                <div class="preference-range-control">
                    <label asp-for="FontScale" class="visually-hidden"></label>
                    <input asp-for="FontScale" class="form-range settings-font-range" type="range" min="0.9" max="1.3" step="0.05" aria-describedby="font-size-help font-size-range" />
                    <output id="font-scale-value" for="FontScale" class="font-scale-value" aria-live="polite">@Model.FontScale.ToString("P0")</output>
                </div>
                <div id="font-size-range" class="preference-range-labels" aria-hidden="true">
                    <span>90%</span>
                    <span>130%</span>
                </div>
                <div id="font-size-help" class="visually-hidden">Adjust from 90% to 130% of the standard text size.</div>
                <span asp-validation-for="FontScale" aria-live="polite" class="text-danger"></span>
            </div>
        </div>

        <div class="preference-row preference-row-options">
            <div class="preference-info">
                <span class="preference-icon preference-icon-options" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M4 7h16M4 12h16M4 17h16" />
                        <circle cx="9" cy="7" r="1.7" />
                        <circle cx="15" cy="12" r="1.7" />
                        <circle cx="11" cy="17" r="1.7" />
                    </svg>
                </span>
                <div>
                    <h2 id="more-options-title">More reading options</h2>
                    <p id="more-options-help">Adjust how content is displayed to make reading easier.</p>
                </div>
            </div>
            <fieldset class="preference-controls preference-checks preference-fieldset" aria-describedby="more-options-help">
                <legend class="visually-hidden">More reading options</legend>
                <div class="form-check preference-check">
                    <input asp-for="IncreasedLineSpacing" class="form-check-input" />
                    <label asp-for="IncreasedLineSpacing" class="form-check-label">Give text more space between lines</label>
                </div>
                <div class="form-check preference-check">
                    <input asp-for="ReduceMotion" class="form-check-input" />
                    <label asp-for="ReduceMotion" class="form-check-label">Reduce animations and motion</label>
                </div>
            </fieldset>
        </div>

        <div class="preference-row preference-row-reminders">
            <div class="preference-info">
                <span class="preference-icon preference-icon-reminders" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M6.5 16.5h11l-1.2-1.7v-4.2a4.3 4.3 0 0 0-8.6 0v4.2l-1.2 1.7Z" />
                        <path d="M10 19.2a2.2 2.2 0 0 0 4 0M12 4V2.8" />
                    </svg>
                </span>
                <div>
                    <h2 id="reminders-title">Practice reminders</h2>
                    <p id="reminder-help">These settings are saved for your in-application practice view. Email and text reminders are not sent.</p>
                </div>
            </div>
            <fieldset class="preference-controls preference-fieldset" aria-describedby="reminder-help">
                <legend class="visually-hidden">Practice reminders</legend>
                <div class="form-check preference-check preference-check-reminders">
                    <input asp-for="RemindersEnabled" class="form-check-input" />
                    <label asp-for="RemindersEnabled" class="form-check-label">Show practice reminders in the app</label>
                </div>
                <div class="preference-reminder-fields">
                    <div>
                        <label asp-for="PreferredReminderTime" class="form-label"></label>
                        <input asp-for="PreferredReminderTime" class="form-control" type="time" step="60" />
                        <span asp-validation-for="PreferredReminderTime" aria-live="polite" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="DailyPracticeTargetMinutes" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="DailyPracticeTargetMinutes" class="form-control" type="number" min="1" max="120" />
                            <span class="input-group-text">minutes</span>
                        </div>
                        <span asp-validation-for="DailyPracticeTargetMinutes" aria-live="polite" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>
        </div>

        <div class="preference-row preference-interests-row">
            <div class="preference-info">
                <span class="preference-icon preference-icon-interests" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M12 19.5S4.5 15.1 4.5 9.4A4 4 0 0 1 12 7.2a4 4 0 0 1 7.5 2.2c0 5.7-7.5 10.1-7.5 10.1Z" />
                    </svg>
                </span>
                <div>
                    <h2 id="interests-title">Learner interests <span class="preference-optional">(optional)</span></h2>
                    <p id="interests-help">Choose topics you enjoy. These choices may be used later for practice-story themes.</p>
                </div>
            </div>
            <fieldset class="preference-controls preference-fieldset" aria-describedby="interests-help">
                <legend class="visually-hidden">Learner interests</legend>
                <span asp-validation-for="SelectedInterests" aria-live="polite" class="text-danger" role="alert"></span>
                @if (Model.AvailableInterests.Count == 0)
                {
                    <p class="text-secondary mb-0">No interest choices are available yet.</p>
                }
                else
                {
                    <div class="preference-interests">
                        @foreach (var interest in Model.AvailableInterests)
                        {
                            var isSelected = Model.SelectedInterests.Contains(interest.Key, StringComparer.OrdinalIgnoreCase);
                            var inputId = $"interest-{interest.Key}";
                            var interestIconClass = interest.Key.Trim().ToLowerInvariant() switch
                            {
                                "space" => "interest-icon-space",
                                "football" => "interest-icon-football",
                                "dinosaurs" => "interest-icon-dinosaurs",
                                "technology" => "interest-icon-technology",
                                "animals" => "interest-icon-animals",
                                "music" => "interest-icon-music",
                                _ => "interest-icon-default"
                            };
                            <div class="preference-interest-option">
                                <input class="form-check-input" type="checkbox" id="@inputId" name="SelectedInterests" value="@interest.Key" checked="@(isSelected ? "checked" : null)" />
                                <label for="@inputId">
                                    <span class="preference-interest-icon @interestIconClass" aria-hidden="true">
                                        @switch (interest.Key.Trim().ToLowerInvariant())
                                        {
                                            case "space":
                                                <svg viewBox="0 0 24 24" focusable="false"><path d="M4 14.5c2.8-3.7 7.1-5.9 12.8-5.9 1.4 0 2.4.2 3.2.4-1.3 1.2-2.4 2.5-3.2 4.1-2.9 0-5.3.7-7.4 2.2-1.8 1.3-3.5 1.4-5.4-.8Z" /><path d="m15.5 6.2 1.1-2.1M7.5 18.2l-1.2 2" /></svg>
                                                break;
                                            case "football":
                                                <svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="8.3" /><path d="m12 8.5 2.1 1.5-.8 2.5h-2.6l-.8-2.5L12 8.5ZM5.2 9.8l3.2.2M15.6 10l3.2-.2M10.1 17l1.1-2.5M13.9 17l-1.1-2.5" /></svg>
                                                break;
                                            case "dinosaurs":
                                                <svg viewBox="0 0 24 24" focusable="false"><path d="M5 17.2h8.3c2.1 0 3.7-1.6 3.7-3.7V9.8h2.3c.8 0 1.2-.9.6-1.5l-2.1-2.1c-.3-.3-.7-.4-1.1-.2l-2.2 1.1H11c-2.9 0-5.2 2.3-5.2 5.2v4.9H5Z" /><path d="M8.2 17.2v2M12.2 17.2v2M16.4 11.7h2.1" /></svg>
                                                break;
                                            case "technology":
                                                <svg viewBox="0 0 24 24" focusable="false"><rect x="4" y="5" width="16" height="11" rx="1.2" /><path d="M2.8 19h18.4M9 19l.8-3h4.4l.8 3" /></svg>
                                                break;
                                            case "animals":
                                                <svg viewBox="0 0 24 24" focusable="false"><path d="M12 18.8c-3 0-5.2-1.7-5.2-4 0-1.8 1.5-3.1 3.1-3.7-.3-.8-.2-1.6.4-2.2.7-.7 1.8-.5 2.3.3.5-.8 1.6-1 2.3-.3.6.6.7 1.4.4 2.2 1.6.6 3.1 1.9 3.1 3.7 0 2.3-2.2 4-5.2 4Z" /><circle cx="8.2" cy="7.7" r="1.4" /><circle cx="15.8" cy="7.7" r="1.4" /></svg>
                                                break;
                                            case "music":
                                                <svg viewBox="0 0 24 24" focusable="false"><path d="M9 17.2V5.7l9-1.7v10.1" /><ellipse cx="6.8" cy="17.6" rx="2.8" ry="2.1" /><ellipse cx="15.8" cy="15.9" rx="2.8" ry="2.1" /></svg>
                                                break;
                                            default:
                                                <svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="3" /></svg>
                                                break;
                                        }
                                    </span>
                                    <span>@interest.DisplayName</span>
                                </label>
                            </div>
                        }
                    </div>
                }
            </fieldset>
        </div>

        <div class="preferences-actions">
            <button type="submit" class="btn btn-primary">
                <svg class="preferences-save-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M5 3.8h11.5L19 6.3V20H5V3.8Z" />
                    <path d="M8 4v5h7V4M8 20v-6h8v6" />
                </svg>
                Save preferences
            </button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const fontScaleInput = document.getElementById("FontScale");
            const fontScaleOutput = document.getElementById("font-scale-value");

            const updateFontScale = () => {
                if (!fontScaleInput) return;

                const minimum = Number(fontScaleInput.min);
                const maximum = Number(fontScaleInput.max);
                const value = Number(fontScaleInput.value);
                const progress = maximum > minimum
                    ? Math.min(1, Math.max(0, (value - minimum) / (maximum - minimum)))
                    : 0;
                const thumbRadius = 9;
                const width = fontScaleInput.clientWidth;
                const fill = width > thumbRadius * 2
                    ? ((thumbRadius + (width - thumbRadius * 2) * progress) / width) * 100
                    : progress * 100;

                fontScaleInput.style.setProperty("--range-fill", fill + "%");
                if (fontScaleOutput) {
                    fontScaleOutput.value = String(Math.round(value * 100)) + "%";
                }
            };

            fontScaleInput?.addEventListener("input", updateFontScale);
            window.addEventListener("resize", updateFontScale, { passive: true });
            updateFontScale();
        })();
    </script>
}
