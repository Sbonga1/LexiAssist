@model LexiAssist.Web.ViewModels.AdminUsers.AdminUserCreateViewModel
@{
    ViewData["Title"] = "Create user";
}

<div class="admin-form-card">
    <p class="auth-eyebrow">Administration</p>
    <h1 class="h2">Create user account</h1>
    <p class="text-secondary">Choose Learner or Psychologist. Administrator accounts cannot be created from this form.</p>

    <form asp-action="Create" method="post" class="auth-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" autocomplete="given-name" autofocus />
                <span asp-validation-for="FirstName" aria-live="polite" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                <span asp-validation-for="LastName" aria-live="polite" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="PreferredName" class="form-label"></label>
                <input asp-for="PreferredName" class="form-control" autocomplete="nickname" />
                <span asp-validation-for="PreferredName" aria-live="polite" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="DateOfBirth" class="form-label"></label>
                <input asp-for="DateOfBirth" class="form-control" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="DateOfBirth" aria-live="polite" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" aria-live="polite" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Role" class="form-label"></label>
            <select asp-for="Role" asp-items="Html.GetEnumSelectList<LexiAssist.Web.ViewModels.AdminUsers.ManagedUserRole>()" class="form-select">
                <option value="">Choose an account type</option>
            </select>
            <span asp-validation-for="Role" aria-live="polite" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" aria-live="polite" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" aria-live="polite" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-2">
            <button type="submit" class="btn btn-primary">Create account</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

