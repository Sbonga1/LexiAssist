@model LexiAssist.Web.ViewModels.AdminUsers.AdminUserEditViewModel
@{
    ViewData["Title"] = "Edit user";
}

<div class="admin-form-card">
    <p class="auth-eyebrow">Administration</p>
    <h1 class="h2">Edit user profile</h1>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="auth-form">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" autocomplete="given-name" autofocus />
                <span asp-validation-for="FirstName" aria-live="polite" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                <span asp-validation-for="LastName" aria-live="polite" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="PreferredName" class="form-label"></label>
                <input asp-for="PreferredName" class="form-control" autocomplete="nickname" />
                <span asp-validation-for="PreferredName" aria-live="polite" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="DateOfBirth" class="form-label"></label>
                <input asp-for="DateOfBirth" class="form-control" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="DateOfBirth" aria-live="polite" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" aria-live="polite" class="text-danger small"></span>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-2">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

