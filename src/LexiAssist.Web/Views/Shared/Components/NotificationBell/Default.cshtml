@model LexiAssist.Web.ViewModels.Notifications.NotificationBellViewModel

<li class="nav-item">
    <a class="nav-link notification-link" asp-controller="Notifications" asp-action="Index" aria-label="Notifications, @Model.UnreadCount unread">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
            <path d="M10 21h4" />
        </svg>
        <span class="visually-hidden">Notifications</span>
        @if (Model.UnreadCount > 0)
        {
            <span class="badge rounded-pill text-bg-danger">@Model.UnreadCount<span class="visually-hidden"> unread</span></span>
        }
    </a>
</li>
