@using LexiAssist.Web.Models.Screening
@model IReadOnlyList<ScreeningActivityMetric>

@if (Model.Count > 0)
{
    <div class="border rounded p-3 mt-3">
        <h3 class="h5 mb-2">Neutral performance summary</h3>
        <p class="small text-secondary mb-3">These descriptive measures come from the configured activities and provide screening information only.</p>
        @foreach (var metric in Model)
        {
            var activityName = metric.ActivityType switch
            {
                ScreeningQuestionType.WorkingMemorySequence => "Working Memory",
                ScreeningQuestionType.TimedMatching => "Processing Efficiency",
                ScreeningQuestionType.PatternReasoning => "Pattern Reasoning",
                _ => metric.ActivityName
            };

            <section class="mb-3 last-child-mb-0" aria-labelledby="learner-metric-@metric.ActivityType-heading">
                <h4 id="learner-metric-@metric.ActivityType-heading" class="h6">@activityName</h4>
                <dl class="row small mb-0">
                    @if (metric.ItemsAttempted is { } itemsAttempted)
                    {
                        <dt class="col-sm-6">Items attempted</dt>
                        <dd class="col-sm-6">@itemsAttempted</dd>
                    }
                    @if (metric.ItemsCorrect is { } itemsCorrect)
                    {
                        <dt class="col-sm-6">Items correct</dt>
                        <dd class="col-sm-6">@itemsCorrect</dd>
                    }
                    @if (metric.ItemsIncorrect is { } itemsIncorrect)
                    {
                        <dt class="col-sm-6">Items incorrect</dt>
                        <dd class="col-sm-6">@itemsIncorrect</dd>
                    }
                    @if (metric.AvailableItemCount is { } availableItemCount)
                    {
                        <dt class="col-sm-6">Configured items</dt>
                        <dd class="col-sm-6">@availableItemCount</dd>
                    }
                    @if (metric.AccuracyPercentage is { } accuracy)
                    {
                        <dt class="col-sm-6">Accuracy</dt>
                        <dd class="col-sm-6">@accuracy.ToString("0.##")%</dd>
                    }
                    @if (metric.HighestCorrectlyCompletedSequenceLength is { } highestSequenceLength)
                    {
                        <dt class="col-sm-6">Highest correctly completed sequence</dt>
                        <dd class="col-sm-6">@highestSequenceLength items</dd>
                    }
                    @if (metric.ElapsedTimeMilliseconds is { } elapsedTime)
                    {
                        <dt class="col-sm-6">Elapsed time</dt>
                        <dd class="col-sm-6">@elapsedTime.ToString("N0") ms</dd>
                    }
                    @if (metric.RawCorrectCount is { } rawCorrectCount)
                    {
                        <dt class="col-sm-6">Raw correct count</dt>
                        <dd class="col-sm-6">@rawCorrectCount.ToString("0.##")</dd>
                    }
                    @if (metric.AvailableScore is { } availableScore)
                    {
                        <dt class="col-sm-6">Available score</dt>
                        <dd class="col-sm-6">@availableScore.ToString("0.##")</dd>
                    }
                    @if (metric.Percentage is { } percentage)
                    {
                        <dt class="col-sm-6">Configured percentage</dt>
                        <dd class="col-sm-6">@percentage.ToString("0.##")%</dd>
                    }
                </dl>
            </section>
        }
    </div>
}
