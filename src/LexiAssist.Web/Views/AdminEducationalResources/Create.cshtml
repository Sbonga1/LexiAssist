@model LexiAssist.Web.ViewModels.Resources.EducationalResourceFormViewModel
@{
    ViewData["Title"] = "Create educational resource";
}

<section class="admin-educational-resource-create-page" aria-labelledby="educational-resource-create-heading">
    <header class="admin-educational-resource-create-heading">
        <p class="auth-eyebrow">Administration · Educational resources</p>
        <h1 id="educational-resource-create-heading">Create educational resource</h1>
        <p>Resources remain drafts until an administrator publishes them.</p>
    </header>

    <section class="admin-educational-resource-create-card" aria-labelledby="educational-resource-details-heading">
        <header class="admin-educational-resource-create-card-header">
            <span class="admin-educational-resource-create-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M6.5 3.5h8l3 3v14h-11Z"></path>
                    <path d="M14.5 3.5v3h3M9 11h5.5M9 14.5h5.5"></path>
                </svg>
            </span>
            <div>
                <h2 id="educational-resource-details-heading">Resource details</h2>
                <p>Enter the main details for this educational resource.</p>
            </div>
        </header>

        <partial name="_Form" model="Model" />
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
