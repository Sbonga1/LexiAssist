@model LexiAssist.Web.ViewModels.Resources.EducationalResourceFormViewModel
@{
    var isEdit = Model.Id != 0;
}
<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : (int?)null)" method="post" class="auth-form">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" autofocus />
        <span asp-validation-for="Title" aria-live="polite" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ResourceType" class="form-label"></label>
        <input asp-for="ResourceType" class="form-control" placeholder="Guide, article, video..." />
        <span asp-validation-for="ResourceType" aria-live="polite" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Summary" class="form-label"></label>
        <textarea asp-for="Summary" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Summary" aria-live="polite" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Content" class="form-label"></label>
        <textarea asp-for="Content" class="form-control" rows="10"></textarea>
        <span asp-validation-for="Content" aria-live="polite" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ExternalUrl" class="form-label"></label>
        <input asp-for="ExternalUrl" class="form-control" type="url" placeholder="https://example.org/resource" />
        <div class="form-text">Optional. Only http and https links are accepted.</div>
        <span asp-validation-for="ExternalUrl" aria-live="polite" class="text-danger small"></span>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-2">
        <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Create draft")</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

