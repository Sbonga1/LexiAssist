@model LexiAssist.Web.ViewModels.Referrals.AdminReferralDetailsViewModel
@{
    ViewData["Title"] = "Referral details";
}

<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
    <div>
        <p class="auth-eyebrow">Administration · Referral</p>
        <h1 class="h2 mb-1">@Model.LearnerName</h1>
        <p class="text-secondary mb-0">@Model.LearnerEmail</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to referrals</a>
</div>

<div class="alert alert-info" role="note">A referral supports follow-up after educational screening. It is not a diagnosis or a clinical conclusion generated by LexiAssist.</div>
@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}

<section class="admin-details-card mb-4" aria-labelledby="referral-summary-heading">
    <h2 id="referral-summary-heading" class="h4">Referral status</h2>
    <dl class="row mb-0">
        <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd>
        <dt class="col-sm-4">Created (UTC)</dt><dd class="col-sm-8">@Model.CreatedAtUtc.ToString("u")</dd>
        <dt class="col-sm-4">First reviewed (UTC)</dt><dd class="col-sm-8">@(Model.ReviewedAtUtc?.ToString("u") ?? "Not reviewed")</dd>
        <dt class="col-sm-4">Support tier</dt><dd class="col-sm-8">@(Model.RiskTier ?? "Not classified")</dd>
        <dt class="col-sm-4">Assigned Psychologist</dt><dd class="col-sm-8">@(Model.Psychologists.FirstOrDefault(person => person.Id == Model.AssignedPsychologistId)?.DisplayName ?? "Unassigned")</dd>
    </dl>
    <a asp-controller="AdminScreeningReports" asp-action="Details" asp-route-id="@Model.ScreeningReportId" class="btn btn-sm btn-outline-primary mt-3">View screening report</a>
</section>

<section class="admin-details-card" aria-labelledby="assignment-heading">
    <h2 id="assignment-heading" class="h4">Assign Psychologist</h2>
    @if (Model.CanAssign)
    {
        <form asp-action="Assign" asp-route-id="@Model.Id" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="col-12 col-md-8">
                <label for="PsychologistId" class="form-label">Active Psychologist account</label>
                <select id="PsychologistId" name="PsychologistId" class="form-select" required>
                    <option value="">Choose a Psychologist</option>
                    @foreach (var psychologist in Model.Psychologists)
                    {
                        <option value="@psychologist.Id" selected="@(Model.AssignedPsychologistId == psychologist.Id)">@psychologist.DisplayName</option>
                    }
                </select>
                <span class="text-danger">@Html.ValidationMessage("PsychologistId")</span>
            </div>
            <div class="col-12 col-md-4 d-grid"><button type="submit" class="btn btn-primary">Save assignment</button></div>
        </form>
    }
    else
    {
        <p class="text-secondary mb-0">Assignment is locked after review has started or the referral has been completed or closed.</p>
    }
</section>

@if (!string.IsNullOrWhiteSpace(Model.Notes))
{
    <section class="admin-details-card mt-4" aria-labelledby="professional-notes-heading">
        <h2 id="professional-notes-heading" class="h4">Professional notes</h2>
        <p class="mb-0">@Model.Notes</p>
    </section>
}
