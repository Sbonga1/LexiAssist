@model LexiAssist.Web.ViewModels.AdminScreeningTests.AdminScreeningQuestionFormViewModel
@{
    ViewData["Title"] = "Edit question";
}

<div class="admin-form-card">
    <p class="auth-eyebrow">Administration · @ViewData["ScreeningTestName"]</p>
    <h1 class="h2">Edit question</h1>
    <p class="text-secondary">Question fields change to match the selected type. Answer lists are entered one response per line.</p>

    <form asp-action="Edit" asp-route-testId="@ViewData["ScreeningTestId"]" asp-route-questionId="@Model.Id" method="post" class="auth-form">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <partial name="_QuestionFormFields" model="Model" />
        <div class="d-flex flex-wrap gap-2 mt-2">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Index" asp-route-testId="@ViewData["ScreeningTestId"]" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/screening-question-form.js" asp-append-version="true"></script>
}
