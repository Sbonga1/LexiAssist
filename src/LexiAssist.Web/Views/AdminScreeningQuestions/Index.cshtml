@model LexiAssist.Web.ViewModels.AdminScreeningTests.AdminScreeningQuestionsIndexViewModel
@{
    ViewData["Title"] = "Questions";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <p class="auth-eyebrow">Administration · Screening Tests</p>
        <h1 class="h2 mb-1">Questions</h1>
        <p class="text-secondary mb-0">@Model.ScreeningTestName</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" asp-route-testId="@Model.ScreeningTestId" class="btn btn-primary">Create question</a>
        <a asp-controller="AdminScreeningTests" asp-action="Details" asp-route-id="@Model.ScreeningTestId" class="btn btn-outline-secondary">Back to test details</a>
    </div>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}

<div class="table-responsive bg-white border rounded-3">
    <table class="table table-hover align-middle mb-0">
        <caption class="visually-hidden">Questions configured for this screening test</caption>
        <thead class="table-light">
            <tr>
                <th scope="col">Order</th>
                <th scope="col">Prompt</th>
                <th scope="col">Type</th>
                <th scope="col">Status</th>
                <th scope="col" class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Questions.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-secondary py-4">No questions have been added to this test.</td></tr>
        }
        else
        {
            @for (var index = 0; index < Model.Questions.Count; index++)
            {
                var question = Model.Questions[index];
                <tr>
                    <td>@question.SortOrder</td>
                    <td class="fw-semibold">@question.Prompt</td>
                    <td>@question.QuestionTypeName</td>
                    <td>
                        @if (question.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex flex-wrap justify-content-end gap-1">
                            <a asp-action="Edit" asp-route-testId="@Model.ScreeningTestId" asp-route-questionId="@question.Id" class="btn btn-sm btn-outline-primary">View / edit</a>
                            <form asp-action="Move" asp-route-testId="@Model.ScreeningTestId" asp-route-questionId="@question.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="direction" value="up" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="Move question up" disabled="@(index == 0 ? "disabled" : null)">↑</button>
                            </form>
                            <form asp-action="Move" asp-route-testId="@Model.ScreeningTestId" asp-route-questionId="@question.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="direction" value="down" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="Move question down" disabled="@(index == Model.Questions.Count - 1 ? "disabled" : null)">↓</button>
                            </form>
                            @if (question.IsActive)
                            {
                                <form asp-action="Deactivate" asp-route-testId="@Model.ScreeningTestId" asp-route-questionId="@question.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Activate" asp-route-testId="@Model.ScreeningTestId" asp-route-questionId="@question.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

<p class="small text-secondary mt-3 mb-0">Questions are deactivated instead of deleted so related records can be preserved.</p>
