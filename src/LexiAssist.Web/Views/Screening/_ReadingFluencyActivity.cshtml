@model LexiAssist.Web.ViewModels.Screening.ScreeningRunnerViewModel

<form id="reading-fluency-activity"
      data-start-url="@Url.Action("StartReadingFluency", "Screening")"
      data-finish-url="@Url.Action("FinishReadingFluency", "Screening")"
      data-return-url="@Url.Action("Resume", "Screening")">
    @Html.AntiForgeryToken()
    <input type="hidden" name="QuestionToken" value="@Model.QuestionToken" />

    <div class="reading-fluency-passage" tabindex="0" aria-label="Passage to read aloud">
        @Model.PassageText
    </div>

    <div class="mt-3 mb-3">
        <p>Read the passage aloud at your usual comfortable pace. Aim for accurate, steady reading. The timer and estimated words per minute describe this activity only; they do not diagnose dyslexia or measure intelligence.</p>
        <p>This activity does not automatically evaluate pronunciation. When ready, start the timer, then choose “I have finished reading” after the passage.</p>
    </div>

    <div class="mb-3" data-reading-fluency-corrections hidden>
        <label for="reading-fluency-correction-count" class="form-label">Optional: how many times did you correct a word while reading?</label>
        <input id="reading-fluency-correction-count" name="CorrectionCount" class="form-control" type="number" min="0" max="5000" inputmode="numeric" />
        <div class="form-text">Leave blank if you are unsure. An assessor supporting you may enter an observed count.</div>
    </div>

    <p class="mt-3 mb-2" role="timer" aria-live="off" aria-atomic="true" aria-label="Elapsed time" data-reading-fluency-timer hidden>Elapsed time: <span data-reading-fluency-elapsed>00:00.0</span></p>
    <button type="button" class="btn btn-primary" data-reading-fluency-start>Start reading</button>
    <button type="button" class="btn btn-primary" data-reading-fluency-finish hidden disabled>I have finished reading</button>

    <div class="alert alert-danger mt-3" role="alert" tabindex="-1" data-reading-fluency-error hidden></div>
    <p class="mt-3" role="status" aria-live="polite" data-reading-fluency-status></p>
</form>
