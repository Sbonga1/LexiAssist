@model LexiAssist.Web.ViewModels.Screening.ScreeningRunnerViewModel

<form id="timed-naming-activity"
      data-start-url="@Url.Action("StartTimedNaming", "Screening")"
      data-finish-url="@Url.Action("FinishTimedNaming", "Screening")"
      data-return-url="@Url.Action("Resume", "Screening")">
    @Html.AntiForgeryToken()
    <input type="hidden" name="QuestionToken" value="@Model.QuestionToken" />

    <div data-timed-naming-instructions>
        <p>Name the 20 items aloud in order, moving left to right and top to bottom. Aim for accurate naming at a steady, efficient pace. A shorter time alone does not mean greater ability or intelligence.</p>
        <p>Complete as many items as you can within @Model.TimedNamingTimeLimitSeconds seconds. The activity records the time and any errors you mark.</p>
        <p>If you notice that you named an item incorrectly, mark it before moving on. This activity does not automatically evaluate pronunciation.</p>
        <button type="button" class="btn btn-primary" data-timed-naming-start>Start activity</button>
    </div>

    <p class="mt-3 mb-2" role="timer" aria-live="off" aria-atomic="true" aria-label="Elapsed time" data-timed-naming-timer hidden>Elapsed time: <span data-timed-naming-elapsed>00:00.0</span> / @Model.TimedNamingTimeLimitSeconds seconds</p>
    <p class="mb-2" data-timed-naming-progress hidden>Item 1 of @Model.TimedNamingItemCount</p>
    <div class="progress mb-3" role="progressbar" aria-label="Rapid naming item progress" aria-valuemin="0" aria-valuemax="@Model.TimedNamingItemCount" aria-valuenow="0" data-timed-naming-progress-bar hidden>
        <div class="progress-bar" style="width: 0%" data-timed-naming-progress-fill></div>
    </div>

    <ol class="timed-naming-grid" aria-label="Items in randomized naming order" data-timed-naming-grid hidden></ol>

    <fieldset class="mt-3" data-timed-naming-controls hidden>
        <legend class="visually-hidden">Current item</legend>
        <div class="form-check mb-3">
            <input id="timed-naming-mark-error" class="form-check-input" type="checkbox" data-timed-naming-error />
            <label for="timed-naming-mark-error" class="form-check-label">I made an error on this item</label>
        </div>
        <button type="button" class="btn btn-primary" data-timed-naming-next>Next item</button>
    </fieldset>

    <div class="alert alert-danger mt-3" role="alert" tabindex="-1" data-timed-naming-error-message hidden></div>
    <p class="mt-3" role="status" aria-live="polite" data-timed-naming-status></p>
</form>
