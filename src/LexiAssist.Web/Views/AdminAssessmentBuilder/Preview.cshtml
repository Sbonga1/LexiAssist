@model LexiAssist.Web.ViewModels.AssessmentBuilder.AssessmentPreviewViewModel
@{
    ViewData["Title"] = "Candidate preview";
    ViewData["AssessmentPreview"] = true;
}

<section class="assessment-candidate-preview assessment-candidate-preview-workspace" aria-labelledby="assessment-preview-heading" data-candidate-preview data-test-id="@Model.ScreeningTestId">
    <header class="assessment-candidate-preview-heading">
        <div>
            <p class="auth-eyebrow">Read-only candidate preview</p>
            <h1 id="assessment-preview-heading">@Model.Name</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="assessment-preview-description">@Model.Description</p>
            }
        </div>
        <a href="@(Model.ReturnUrl ?? Url.Action("Index", new { testId = Model.ScreeningTestId }))" class="assessment-builder-button assessment-builder-button-secondary">‹&nbsp; @Model.ReturnLabel</a>
    </header>

    <div class="assessment-preview-topline">
        <div class="assessment-preview-mode" role="group" aria-label="Candidate preview layout">
            <button type="button" class="assessment-preview-mode-button" data-preview-mode="list" aria-pressed="true">☷ <span>List view</span></button>
            <button type="button" class="assessment-preview-mode-button" data-preview-mode="pager" aria-pressed="false">▣ <span>Pager view</span></button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Instructions))
    {
        <details class="assessment-candidate-instructions assessment-preview-instructions">
            <summary>Assessment instructions</summary>
            <p>@Model.Instructions</p>
        </details>
    }

    <div class="assessment-preview-info" role="note">
        <span class="assessment-preview-info-icon" aria-hidden="true">i</span>
        <div><strong>This is a preview only</strong><span>This preview does not record answers or create an attempt.</span></div>
    </div>

    @if (Model.Questions.Count == 0)
    {
        <div class="assessment-builder-empty assessment-preview-empty"><h2>No active questions to preview</h2><p>Activate questions in the builder to include them in this preview.</p></div>
    }
    else
    {
        <div class="assessment-preview-pager" data-preview-pager hidden>
            <div class="assessment-preview-progress-heading">
                <p data-preview-question-count aria-live="polite">Question 1 of @Model.Questions.Count</p>
                <span data-preview-progress-label>0%</span>
            </div>
            <progress data-preview-progress value="0" max="100" aria-label="Question progress"></progress>
        </div>

        <ol class="assessment-candidate-question-list" data-preview-question-list>
            @for (var index = 0; index < Model.Questions.Count; index++)
            {
                var question = Model.Questions[index];
                <li data-preview-question data-question-index="@index" data-question-type="@question.QuestionType">
                    <partial name="~/Views/AdminAssessmentBuilder/_CandidateQuestion.cshtml" model="question" view-data='@(new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["PreviewIndex"] = index, ["InteractivePreview"] = true })' />
                </li>
            }
        </ol>

        <nav class="assessment-preview-pagination" aria-label="Preview question navigation" data-preview-navigation hidden>
            <button type="button" class="assessment-builder-button" data-preview-previous disabled>← <span>Previous</span></button>
            <div class="assessment-preview-page-numbers" data-preview-page-numbers aria-label="Choose a question"></div>
            <button type="button" class="assessment-builder-button assessment-builder-button-primary" data-preview-next><span>Next</span> →</button>
        </nav>
    }
</section>

@section Scripts
{
    @if (Model.Questions.Count > 0)
    {
        <script src="~/js/admin-candidate-preview.js" asp-append-version="true" defer></script>
    }
}
